<script type="text/javascript">
require(['jquery'], function($) {
    $(document).ready(function() {
        const ajaxUrl = <?= json_encode($ajaxUrl) ?>;

        // Tab switching
        $('.syncengine-tab-btn').on('click', function(e) {
            e.preventDefault();
            const tabName = $(this).data('tab');
            
            // Remove active class from all buttons and content
            $('.syncengine-tab-btn').removeClass('active');
            $('.syncengine-tab-content').removeClass('active');
            
            // Add active class to clicked button and corresponding content
            $(this).addClass('active');
            $('#' + tabName).addClass('active');
        });

        // Endpoint status loading
        $('.syncengine-load-status-btn').on('click', function(e) {
            e.preventDefault();
            const $btn = $(this);
            const $row = $btn.closest('tr');
            const endpoint = $btn.data('endpoint');
            const formKey = $btn.data('form-key');
            const originalText = $btn.text();

            $btn.prop('disabled', true);
            $btn.text('Loading...');

            $.ajax({
                url: ajaxUrl,
                type: 'POST',
                dataType: 'json',
                data: {
                    endpoint: endpoint,
                    form_key: formKey
                },
                success: function(response) {
                    if (response.success) {
                        const data = response.data || {};
                        let statusLabel = data.status || 'unknown';

                        if (data.message) {
                            statusLabel += ' - ' + data.message;
                        }
                        if (data.error) {
                            statusLabel += ' - ' + data.error;
                        }

                        // Build trace counters
                        const runningCount = Array.isArray(data.running) ? data.running.length : 0;
                        const scheduledCount = Array.isArray(data.scheduled) ? data.scheduled.length : 0;
                        const queuedCount = Array.isArray(data.queued) ? data.queued.length : 0;

                        let traceLabel = '';
                        if (runningCount > 0) traceLabel += 'running: ' + runningCount;
                        if (scheduledCount > 0) traceLabel += (traceLabel ? ' | ' : '') + 'scheduled: ' + scheduledCount;
                        if (queuedCount > 0) traceLabel += (traceLabel ? ' | ' : '') + 'queued: ' + queuedCount;

                        $row.find('.syncengine-status-cell').text(statusLabel);
                        $row.find('.syncengine-trace-cell').text(traceLabel || '—');
                        $btn.text('Refresh status');
                    } else {
                        const errorMsg = response.message || 'Failed to load status';
                        $row.find('.syncengine-status-cell').text('Error: ' + errorMsg);
                    }
                    $btn.prop('disabled', false);
                },
                error: function(xhr, status, error) {
                    $row.find('.syncengine-status-cell').text('Error: ' + error);
                    $btn.prop('disabled', false);
                    $btn.text(originalText);
                }
            });
        });
    });
});
</script>

